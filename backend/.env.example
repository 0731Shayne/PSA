# Probability & Mathematical Statistics Teaching Assistant

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8101
SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173

# Development-only one-click teacher login
DEV_LOGIN_ENABLED=false
DEV_LOGIN_USER_ID=local-teacher
DEV_LOGIN_NAME=本地教师
DEV_LOGIN_ROLE=teacher

DATABASE_URL=sqlite+aiosqlite:///./teaching_assistant.db
QUESTION_BANK_PATH=./data/probability_questions.jsonl

# Docker Compose / PostgreSQL (replace the password before startup)
POSTGRES_DB=mra
POSTGRES_USER=mra
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Optional: create the first teacher once when the database is empty
BOOTSTRAP_TEACHER_USERNAME=
BOOTSTRAP_TEACHER_PASSWORD=
BOOTSTRAP_TEACHER_NAME=初始教师

# Required only when allowing teachers to self-register
TEACHER_REGISTRATION_CODE=

DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
# Keep false to connect directly even if stale HTTP_PROXY variables exist.
DEEPSEEK_USE_ENV_PROXY=false
DEEPSEEK_MOCK=false

# MinerU Cloud OCR for handwritten JPG/PNG/WebP submissions
MINERU_TOKEN=replace-with-your-mineru-token
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL=vlm
MINERU_TIMEOUT_SECONDS=120
# Keep false to connect directly even if stale HTTP_PROXY variables exist.
MINERU_USE_ENV_PROXY=false

# Course material backend: local for the portfolio demo, ragflow for company
# deployment, or disabled to run only the built-in question bank.
KNOWLEDGE_BACKEND=local

# Local demo: Ollama generates real bge-m3 embeddings; PSA stores a small
# number of vectors in SQLite and calculates cosine similarity itself.
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_TIMEOUT_SECONDS=60
LOCAL_EMBEDDING_USE_ENV_PROXY=false
LOCAL_EMBEDDING_BATCH_SIZE=16
LOCAL_CHUNK_SIZE=900
LOCAL_CHUNK_OVERLAP=120

# Enterprise handoff: set KNOWLEDGE_BACKEND=ragflow after RAGFlow is deployed.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=replace-with-your-ragflow-api-key
# Leave blank to use RAGFlow's configured default. For a local model the value
# must use RAGFlow's model_name@provider format, e.g. bge-m3@Ollama.
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_RERANK_ID=
RAGFLOW_CHUNK_METHOD=book
RAGFLOW_TIMEOUT_SECONDS=30
RAGFLOW_VERIFY_SSL=true
RAGFLOW_USE_ENV_PROXY=false
RAGFLOW_MAX_FILE_MB=50
RAGFLOW_RETRIEVAL_PAGE_SIZE=6
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.5
RAGFLOW_TOP_K=256
